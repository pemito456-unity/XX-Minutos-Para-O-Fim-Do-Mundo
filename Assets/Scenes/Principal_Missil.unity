  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "N\xCDVEIS DEFCON\nEscala militar americana de prontid\xE3o para guerra
    nuclear, variando de 5 (normal) a 1 (guerra iminente\n\nDEFCON 5\nCondi\xE7\xE3o
    normal de prontid\xE3o militar.\nMonitoramento de rotina e baixa probabilidade
    de conflito nuclear.\n\nDEFCON 4\nEstado de alerta elevado.\nVigil\xE2ncia refor\xE7ada
    devido \xE0s tens\xF5es da Guerra Fria.\nEstado atual dos EUA devido a guerra
    fria.\n\nDEFCON 3\nFor\xE7as armadas em prontid\xE3o acelerada.\nPossibilidade
    de conflito considerada real.\n\nDEFCON 2\nPrepara\xE7\xE3o m\xE1xima para guerra
    nuclear.\nRetalia\xE7\xE3o estrat\xE9gica pode ser autorizada a qualquer momento.\n\nDEFCON
    1\nGuerra nuclear ou iminente, ou em andamento.\nProtocolos de ataque total autorizados.\n\nOgiva\nCarga
    explosiva transportada por um m\xEDssil.\n\nICBM\nM\xEDssil bal\xEDstico intercontinental
    capaz de atravessar continentes carregando ogivas nucleares."
