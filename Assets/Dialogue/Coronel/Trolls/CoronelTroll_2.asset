  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6cb3f5ff6b5fadc448a6545d333ba265, type: 3}
  m_Name: CoronelTroll_2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: Coronel
  speakerType: 0
  speakerPortrait: {fileID: 7597935454189737829, guid: 184d36dd661ff3e4b9fc015f6ced2ea4, type: 3}
  dialogueText: "General, os comandantes das bases est\xE3o \xE0 beira de um motim.
    Eles querem subir o n\xEDvel de alerta agora. O que devo dizer a eles?"
  isMandatory: 0
  timeToDecide: 15
  choices:
  - buttonText: "Diga que subam para DEFCON 1 imediatamente. \xC9 melhor prevenir
      do que remediar."
    pressureChange: 10
    advancesInvestigation: 0
    speakerReaction: "...S\xE9rio? Eles v\xE3o interpretar isso como p\xE2nico. Acabei
      de dar muni\xE7\xE3o pra quem diz que estamos perdendo o controle."
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  - buttonText: "Diga que estamos avaliando a situa\xE7\xE3o e que mantenham DEFCON
      4 por enquanto."
    pressureChange: 0
    advancesInvestigation: 0
    speakerReaction: "Mantemos DEFCON 4? Eles n\xE3o v\xE3o gostar nada disso, mas
      vou tentar segurar a onda."
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  - buttonText: "Diga que eu autorizo DEFCON 2 nas bases priorit\xE1rias."
    pressureChange: -10
    advancesInvestigation: 0
    speakerReaction: "Entendido. Isso vai acalm\xE1-los um pouco"
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  dialogueStartClip: {fileID: 0}
  speakerVoiceClip: {fileID: 0}
