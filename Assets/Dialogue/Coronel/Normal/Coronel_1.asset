  m_Script: {fileID: 11500000, guid: 6cb3f5ff6b5fadc448a6545d333ba265, type: 3}
  m_Name: Coronel_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: Coronel
  speakerType: 0
  speakerPortrait: {fileID: 7597935454189737829, guid: 184d36dd661ff3e4b9fc015f6ced2ea4, type: 3}
  dialogueText: "As trajet\xF3rias correspondem aos corredores de lan\xE7amento sovi\xE9ticos
    conhecidos?"
  isMandatory: 0
  timeToDecide: 15
  choices:
  - buttonText: "Eles passaram por regi\xF5es historicamente usadas em testes de
      m\xEDsseis."
    pressureChange: 10
    advancesInvestigation: 0
    speakerReaction: "Isso j\xE1 \xE9 confirma\xE7\xE3o suficiente."
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  - buttonText: "As rotas cruzam essas regi\xF5es, mas n\xE3o se originaram nelas."
    pressureChange: 0
    advancesInvestigation: 0
    speakerReaction: "Esclare\xE7a isso imediatamente."
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  - buttonText: "O ponto de origem deles antecede qualquer evento de lan\xE7amento
      conhecido."
    pressureChange: -10
    advancesInvestigation: 0
    speakerReaction: "Isso\u2026 deveria ser imposs\xEDvel."
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  dialogueStartClip: {fileID: 0}
  speakerVoiceClip: {fileID: 0}
