  m_Script: {fileID: 11500000, guid: 8f3c2a1b9e4d5647a8b9c0d1e2f3a4b5, type: 3}
  m_Name: Cientista_3
  m_EditorClassIdentifier: Assembly-CSharp::ScientistConversationData
  speakerName: Cientista
  speakerPortrait: {fileID: -3115044460567940278, guid: 10e559fa91a58d34b8ecc16d6b2896cc, type: 3}
  timeToDecidePerResponse: 15
  advancesInvestigationOnComplete: 1
  exchanges:
  - scientistLine: "General French, sobrevoamos as crateras com medidores Geiger
      de longo alcance abordo de ca\xE7as supers\xF4nicos. Detectamos uma forte presen\xE7a
      de material radioativo no local de impacto."
    playerResponse:
      buttonText: E quanto aos locais em volta?
      pressureChange: 0
      advancesInvestigation: 1
  - scientistLine: "Desculpe, senhor, mas n\xE3o entendo a necessidade da sua pergunta."
    playerResponse:
      buttonText: "Bombas nucleares espalhariam o material radioativo, ele n\xE3o
        se concentraria apenas no centro do impacto. Mandem os ca\xE7as darem meia-volta
        imediatamente."
      pressureChange: 0
      advancesInvestigation: 1
  closingScientistLine: 
  dialogueStartClip: {fileID: 0}
