  speakerPortrait: {fileID: -6201435598855776564, guid: 7276b97a10977ed4fa4a22a5cb1a6cb0, type: 3}
  timeToDecidePerResponse: 15
  advancesInvestigationOnComplete: 1
  exchanges:
  - scientistLine: "General Alastair, sou o doutor Armstrong respons\xE1vel pelo
      observat\xF3rio Lick. Nossa equipe detectou um compacto grupo de corpos celestes
      em rota de colis\xE3o com a Terra, fazem duas semanas. Nossa mensagem nunca
      chegou at\xE9 o alto escal\xE3o do governo. "
    playerResponse:
      buttonText: "viajando a 18 quil\xF4metros por hora e vindo do norte?"
      pressureChange: 0
      advancesInvestigation: 1
  - scientistLine: "Exatamente, senhor. Parece que o senhor j\xE1 sabia do que se
      trata."
    playerResponse:
      buttonText: "Tive minhas d\xFAvidas, mas s\xF3 agora tive confirma\xE7\xE3o."
      pressureChange: 0
      advancesInvestigation: 1
  closingScientistLine: 
  dialogueStartClip: {fileID: 0}
