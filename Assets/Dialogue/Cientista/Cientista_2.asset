  exchanges:
  - scientistLine: "General, recebemos an\xE1lises preliminares dos locais de impacto.
      Richmond, Virginia foi significantemente destru\xEDda. Estimam um impacto de
      10 megatons. Conclu\xEDmos que se trata de uma ogiva nuclear."
    playerResponse:
      buttonText: "E quanto \xE0s leituras de radia\xE7\xE3o?"
      pressureChange: 0
      advancesInvestigation: 1
  - scientistLine: "...n\xE3o foram feitas, senhor. Apenas sobrevoamos a \xE1rea
      com ca\xE7as."
    playerResponse:
      buttonText: "Inaceit\xE1vel! Fale comigo apenas quando obtiver leituras precisas.
        French desligando."
      pressureChange: 0
      advancesInvestigation: 1
  closingScientistLine: 
  dialogueStartClip: {fileID: 0}
