  m_Name: Cientista_1
  m_EditorClassIdentifier: Assembly-CSharp::ScientistConversationData
  speakerName: Cientista
  speakerPortrait: {fileID: -3115044460567940278, guid: 10e559fa91a58d34b8ecc16d6b2896cc, type: 3}
  timeToDecidePerResponse: 15
  advancesInvestigationOnComplete: 1
  exchanges:
  - scientistLine: "General French, Dr. Elias Voss do comit\xEA de emerg\xEAncias
      dos EUA falando. Estamos coletando intelig\xEAncia para auxiliar a tomada de
      decis\xF5es do governo americano nesta crise."
    playerResponse:
      buttonText: "Doutor, meus sistemas registram leituras anormais. Pode se tratar
        de m\xEDsseis muito al\xE9m do nosso conhecimento tecnol\xF3gico, mas ainda
        n\xE3o posso afirmar nada, muito menos decidir retaliar, e contra quem."
      pressureChange: 0
      advancesInvestigation: 1
  - scientistLine: "\xC9 para isso que estamos trabalhando, senhor - para te dar
      informa\xE7\xF5es - mas precisamos de tempo para concluir nossas pesquisas."
    playerResponse:
      buttonText: "Se \xE9 tempo que precisam, ent\xE3o vou ganhar tempo. French
        desligando."
      pressureChange: 0
      advancesInvestigation: 1
  closingScientistLine: 
  dialogueStartClip: {fileID: 0}
