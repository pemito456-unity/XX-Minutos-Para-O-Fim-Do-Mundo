--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6cb3f5ff6b5fadc448a6545d333ba265, type: 3}
  m_Name: SecretarioTroll_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: "Secret\xE1rio"
  speakerType: 1
  speakerPortrait: {fileID: -5632654425947497670, guid: f2bb9abbeaa35474492c503b7694108d, type: 3}
  dialogueText: "French, a situa\xE7\xE3o nas ruas est\xE1 ficando feia. As pessoas
    est\xE3o ouvindo rumores de guerra nuclear. Devemos fazer algum pronunciamento
    forte para acalmar a popula\xE7\xE3o?"
  isMandatory: 0
  timeToDecide: 15
  choices:
  - buttonText: "Fa\xE7a um pronunciamento afirmando que controlamos a situa\xE7\xE3o
      e que n\xE3o h\xE1 motivo para p\xE2nico."
    pressureChange: 10
    advancesInvestigation: 0
    speakerReaction: "Controlamos a situa\xE7\xE3o? General, metade de Baltimore
      j\xE1 est\xE1 em chamas. Isso vai soar como mentira descarada."
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  - buttonText: "Diga que estamos monitorando a situa\xE7\xE3o com a m\xE1xima seriedade
      e que todas as medidas est\xE3o sendo tomadas."
    pressureChange: 0
    advancesInvestigation: 0
    speakerReaction: "Uma resposta cl\xE1ssica de pol\xEDtico. Espero que seja suficiente
      por enquanto."
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  - buttonText: "Diga \xE0 popula\xE7\xE3o para permanecer calma e em suas casas.
      Evacuar agora s\xF3 criaria mais caos."
    pressureChange: -10
    advancesInvestigation: 0
    speakerReaction: "Ficar em casa enquanto coisas caem do c\xE9u? General\u2026
      isso pode ser interpretado como abandono da popula\xE7\xE3o."
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  dialogueStartClip: {fileID: 0}
  speakerVoiceClip: {fileID: 0}
