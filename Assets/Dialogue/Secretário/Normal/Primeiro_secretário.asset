  m_Script: {fileID: 11500000, guid: 6cb3f5ff6b5fadc448a6545d333ba265, type: 3}
  m_Name: "Primeiro_secret\xE1rio"
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: "Secret\xE1rio"
  speakerType: 1
  speakerPortrait: {fileID: -5632654425947497670, guid: f2bb9abbeaa35474492c503b7694108d, type: 3}
  dialogueText: "General Alastair, o que est\xE1 acontecendo? De onde est\xE3o vindo
    estes m\xEDsseis?"
  isMandatory: 0
  timeToDecide: 15
  choices:
  - buttonText: "N\xE3o sabemos ainda, mas eles foram detectados em \xF3rbita alta."
    pressureChange: 0
    advancesInvestigation: 0
    skipTutorial: 0
    speakerReaction: "Isso \xE9 de se esperar de m\xEDsseis intercontinentais."
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  - buttonText: Sabemos apenas que vieram do norte do planeta.
    pressureChange: 10
    advancesInvestigation: 0
    skipTutorial: 0
    speakerReaction: "Do norte? Isso s\xF3 pode significar que sobrevoaram as calotas
      polares vindo da Uni\xE3o Sovi\xE9tica!"
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  - buttonText: "Dados do sistema n\xE3o condizem com m\xEDsseis, talvez sejam detec\xE7\xF5es
      falsas"
    pressureChange: 0
    advancesInvestigation: 0
    skipTutorial: 0
    speakerReaction: "N\xE3o seria a primeira vez, apesar de improv\xE1vel. Preciso
      de mais detalhes urgentemente."
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
