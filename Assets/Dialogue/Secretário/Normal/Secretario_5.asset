  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6cb3f5ff6b5fadc448a6545d333ba265, type: 3}
  m_Name: Secretario_5
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  speakerName: "Secret\xE1rio"
  speakerType: 1
  speakerPortrait: {fileID: -5632654425947497670, guid: f2bb9abbeaa35474492c503b7694108d, type: 3}
  dialogueText: "French, h\xE1 rumores nas ruas de guerra nuclear. Devemos fazer
    algum pronunciamento?"
  isMandatory: 0
  timeToDecide: 15
  choices:
  - buttonText: "Afirme que controlamos a situa\xE7\xE3o e que n\xE3o h\xE1 motivo
      para p\xE2nico."
    pressureChange: 10
    advancesInvestigation: 0
    skipTutorial: 0
    speakerReaction: "Controlamos a situa\xE7\xE3o? General, metade de Baltimore
      j\xE1 est\xE1 em chamas!"
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  - buttonText: "Diga que estamos monitorando a situa\xE7\xE3o e que as medidas necess\xE1rias
      est\xE3o sendo tomadas."
    pressureChange: -10
    advancesInvestigation: 0
    skipTutorial: 0
    speakerReaction: "Uma resposta cl\xE1ssica de pol\xEDtico. Espero que seja suficiente,
      por enquanto..."
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  - buttonText: "Diga \xE0 popula\xE7\xE3o para permanecer calma e em suas casas.
      Evacuar agora s\xF3 criaria mais caos."
    pressureChange: 0
    advancesInvestigation: 0
    skipTutorial: 0
    speakerReaction: "De fato, \xE9 tarde demais para evacuar, mas n\xE3o acho que
      isso ser\xE1 de muita ajuda..."
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  dialogueStartClip: {fileID: 0}
  speakerVoiceClip: {fileID: 0}
