    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  - buttonText: "Temos objetos descendentes de composi\xE7\xE3o e origem desconhecidas."
    pressureChange: 0
    advancesInvestigation: 0
    speakerReaction: "Desconhecidas? Isso n\xE3o \xE9 nada reconfortante, continue."
    animationTrigger: 
    reactionSound: {fileID: 0}
    screenFlashColor: {r: 0, g: 0, b: 0, a: 0}
    screenFlashDuration: 0
    spawnRateModifier: 0
    extraDefenderDamage: 0
  - buttonText: "N\xE3o identificamos assinaturas de propuls\xE3o t\xEDpicas de m\xEDsseis."
    pressureChange: -10
    advancesInvestigation: 0
    speakerReaction: "Ent\xE3o voc\xEA est\xE1 dizendo que isso pode n\xE3o ser um
      ataque?"
